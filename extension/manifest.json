{
  "manifest_version": 3,
  "name": "ContaIA DIAN - Descarga Directa",
  "version": "1.0.0",
  "description": "Permite a ContaIA descargar facturas de la DIAN usando tu sesión del navegador (evita el bloqueo de Cloudflare).",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://catalogo-vpfe.dian.gov.co/*",
    "https://contaiaflex.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://contaiaflex.netlify.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
